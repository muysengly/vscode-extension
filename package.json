{
  "name": "vscode-extension",
  "displayName": "vscode-extension",
  "description": "Send file line references to OpenCode in the terminal.",
  "version": "0.0.1",
  "publisher": "muysengly",
  "icon": "icons/bun.png",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "extension.send",
        "title": "Send Selection to OpenCode"
      },
      {
        "command": "extension.sendSelected",
        "title": "Send to OpenCode"
      },
      {
        "command": "extension.explorerBlank",
        "title": "OpenCode: Explorer Has No Selection"
      },
      {
        "command": "extension.focus",
        "title": "OpenCode: Focus Terminal"
      },
      {
        "command": "extension.startOpenCode",
        "title": "OpenCode: Start / Resume"
      }
    ],
    "configuration": {
      "title": "OpenCode",
      "properties": {}
    },
    "keybindings": [
      {
        "key": "ctrl+'",
        "command": "extension.focus",
        "when": "!editorTextFocus && !filesExplorerFocus"
      },
      {
        "key": "ctrl+'",
        "command": "extension.send",
        "when": "editorTextFocus"
      },
      {
        "key": "ctrl+'",
        "command": "extension.explorerBlank",
        "when": "filesExplorerFocus && !listHasSelectionOrFocus"
      },
      {
        "key": "ctrl+'",
        "command": "extension.sendSelected",
        "when": "filesExplorerFocus && listHasSelectionOrFocus"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "when": "editorTextFocus",
          "command": "extension.send",
          "group": "navigation@1"
        }
      ],
      "explorer/context": [
        {
          "when": "explorerResourceIsFolder || listHasSelectionOrFocus",
          "command": "extension.sendSelected",
          "group": "navigation@1"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "npm run compile && vsce package --out vscode-extension-0.0.1.vsix --allow-missing-repository"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/vscode": "^1.75.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.4.0"
  }
}
