{
  "name": "vscode-extension",
  "displayName": "vscode-extension",
  "description": "OpenCode in the secondary side bar. Send file/folder references to it.",
  "version": "0.0.1",
  "publisher": "muysengly",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:extension.send",
    "onCommand:extension.sendFromExplorer",
    "onView:opencode.view"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "OpenCode",
      "properties": {
        "opencode.loadDelaySeconds": {
          "type": "number",
          "default": 3,
          "minimum": 0,
          "description": "Seconds to wait for OpenCode to finish loading before sending a reference to it."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "opencode",
          "title": "OpenCode",
          "icon": "$(terminal)"
        }
      ]
    },
    "views": {
      "opencode": [
        {
          "type": "webview",
          "id": "opencode.view",
          "name": "OpenCode",
          "location": "secondarySideBar"
        }
      ]
    },
    "commands": [
      {
        "command": "extension.send",
        "title": "Extension: Send File Line Range to OpenCode"
      },
      {
        "command": "extension.sendFromExplorer",
        "title": "Send File/Folder to OpenCode"
      }
    ],
    "keybindings": [
      {
        "key": "ctrl+shift+o",
        "command": "extension.send",
        "when": "editorTextFocus"
      },
      {
        "key": "ctrl+shift+o",
        "command": "extension.sendFromExplorer",
        "when": "filesExplorerFocus"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "npm run compile && vsce package --out vscode-extension-0.0.1.vsix --allow-missing-repository"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/vscode": "^1.75.0",
    "@vscode/vsce": "^2.24.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "node-pty": "^1.1.0"
  }
}
