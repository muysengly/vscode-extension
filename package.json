{
  "name": "vscode-extension",
  "displayName": "vscode-extension",
  "description": "Send file/folder references to the OpenCode terminal",
  "version": "0.0.1",
  "publisher": "muysengly",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:extension.send",
    "onCommand:extension.sendFromExplorer"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "extension.send",
        "title": "Extension: Send File Line Range to OpenCode"
      },
      {
        "command": "extension.sendFromExplorer",
        "title": "Send File/Folder to OpenCode"
      }
    ],
    "keybindings": [
      {
        "key": "ctrl+shift+o",
        "command": "extension.send",
        "when": "editorTextFocus"
      },
      {
        "key": "ctrl+shift+o",
        "command": "extension.sendFromExplorer",
        "when": "filesExplorerFocus"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "npm run compile && vsce package --out vscode-extension-0.0.1.vsix --allow-missing-repository"
  },
  "devDependencies": {
    "@types/vscode": "^1.75.0",
    "@vscode/vsce": "^2.24.0",
    "typescript": "^5.4.0"
  }
}
