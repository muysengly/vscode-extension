{
  "name": "extension",
  "displayName": "extension",
  "description": "Send @file#Lstart-end reference to the active terminal",
  "version": "0.0.1",
  "publisher": "muysengly",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:extension.send"
  ],
  "main": "./main.js",
  "contributes": {
    "commands": [
      {
        "command": "extension.send",
        "title": "Extension: Send File Line Range"
      }
    ],
    "keybindings": [
      {
        "key": "ctrl+shift+o",
        "command": "extension.send",
        "when": "editorTextFocus"
      }
    ]
  },
  "scripts": {
    "package": "vsce package"
  },
  "devDependencies": {
    "@vscode/vsce": "^2.24.0"
  }
}
