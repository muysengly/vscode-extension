{
  "name": "vscode-extension",
  "displayName": "vscode-extension",
  "description": "Send file line references to OpenCode in the terminal.",
  "version": "0.0.1",
  "publisher": "muysengly",
  "icon": "icons/bun.png",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "extension.send",
        "title": "Extension: Send Cursor Line or Selection to OpenCode"
      },
      {
        "command": "extension.sendSelected",
        "title": "Extension: Send Selected File/Folder to OpenCode"
      },
      {
        "command": "extension.explorerBlank",
        "title": "Extension: Explorer Has No Selection"
      },
      {
        "command": "extension.focus",
        "title": "Extension: Focus OpenCode Terminal"
      },
      {
        "command": "extension.startOpenCode",
        "title": "OpenCode: Start / Resume"
      }
    ],
    "configuration": {
      "title": "OpenCode",
      "properties": {
        "opencode.venvPath": {
          "type": "string",
          "default": "",
          "description": "Path to your Python .venv folder. If empty, auto-detects .venv in the workspace root."
        },
        "python.terminal.activateEnvironment": {
          "type": "boolean",
          "default": false,
          "description": "Prevents the Python extension from injecting venv activation into OpenCode terminals."
        }
      }
    },
    "keybindings": [
      {
        "key": "ctrl+'",
        "command": "extension.focus",
        "when": "!editorTextFocus && !filesExplorerFocus"
      },
      {
        "key": "ctrl+'",
        "command": "extension.send",
        "when": "editorTextFocus"
      },
      {
        "key": "ctrl+'",
        "command": "extension.explorerBlank",
        "when": "filesExplorerFocus && !listHasSelectionOrFocus"
      },
      {
        "key": "ctrl+'",
        "command": "extension.sendSelected",
        "when": "filesExplorerFocus && listHasSelectionOrFocus"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "npm run compile && vsce package --out vscode-extension-0.0.1.vsix --allow-missing-repository"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/vscode": "^1.75.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.4.0"
  }
}
